<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LmsApp.ViewModels"
             xmlns:m="clr-namespace:LmsApp.Models.Domain"
             x:Class="LmsApp.Views.CourseDetailPage"
             x:DataType="vm:CourseDetailViewModel"
             Title="{Binding Course.Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="←" Command="{Binding GoBackCommand}"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center"/>

            <!-- Course info header -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBusy, Converter={StaticResource InvertBool}}">
                <Label Text="{Binding Course.Title}"
                       Style="{StaticResource H2}"
                       IsVisible="{Binding Course.Title, Converter={StaticResource StringNotEmpty}}"/>
                <Label Text="{Binding Course.Description}"
                       Style="{StaticResource Body}"
                       IsVisible="{Binding Course.Description, Converter={StaticResource StringNotEmpty}}"/>

                <!-- Deadline warning -->
                <Border IsVisible="{Binding HasDeadlineWarning}"
                        BackgroundColor="{StaticResource WarningLight}"
                        Stroke="{StaticResource Warning}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,8">
                    <Label Text="{Binding DeadlineText}"
                           TextColor="{StaticResource Warning}"
                           FontAttributes="Bold"/>
                </Border>

                <!-- Progress -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ProgressBar Grid.Column="0"
                                 Progress="{Binding OverallProgress, Converter={StaticResource PercentToProgress}}"
                                 ProgressColor="{StaticResource Primary}"
                                 VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="{Binding OverallProgress, StringFormat='{0}%'}"
                           Style="{StaticResource Caption}"
                           VerticalOptions="Center"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Modules list -->
            <Label Text="Модули" Style="{StaticResource H3}"/>

            <CollectionView ItemsSource="{Binding Modules}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Module">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CourseDetailViewModel}}, Path=OpenModuleCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <!-- Type icon -->
                                <Label Grid.Column="0"
                                       Text="{Binding Type, Converter={StaticResource ModuleTypeToIcon}}"
                                       FontSize="24"
                                       VerticalOptions="Center"/>
                                <!-- Info -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="15"/>
                                    <Label Text="{Binding DurationMin, StringFormat='{0} мин'}"
                                           Style="{StaticResource Caption}"/>
                                </VerticalStackLayout>
                                <!-- Status -->
                                <Label Grid.Column="2"
                                       Text="✓"
                                       FontSize="18"
                                       TextColor="{Binding Status, Converter={StaticResource StatusToColor}}"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- CTA Button -->
            <Button Text="{Binding CtaText}"
                    Command="{Binding StartContinueCommand}"
                    Style="{StaticResource PrimaryButton}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
