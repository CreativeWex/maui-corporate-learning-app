<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LmsApp.ViewModels"
             xmlns:m="clr-namespace:LmsApp.Models.Domain"
             xmlns:controls="clr-namespace:LmsApp.Controls"
             x:Class="LmsApp.Views.LeaderboardPage"
             x:DataType="vm:LeaderboardViewModel"
             SafeAreaEdges="All"
             Shell.NavBarIsVisible="False"
             Title="Рейтинг">

    <Grid RowDefinitions="Auto,*">
    <controls:NavBar Grid.Row="0" Title="Рейтинг"/>
    <RefreshView Grid.Row="1"
                 Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Loading -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"/>

                <!-- Scope selector -->
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Button Text="Команда"
                            Command="{Binding SelectScopeCommand}"
                            CommandParameter="Команда"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="13">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedScope}" Value="Команда">
                                <Setter Property="Style" Value="{StaticResource PrimaryButton}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Компания"
                            Command="{Binding SelectScopeCommand}"
                            CommandParameter="Компания"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="13">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedScope}" Value="Компания">
                                <Setter Property="Style" Value="{StaticResource PrimaryButton}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>

                <!-- Podium top 3 -->
                <Grid ColumnDefinitions="*,Auto,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="8"
                      IsVisible="{Binding First, Converter={StaticResource StringNotEmpty}}">

                    <!-- 2nd place -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0"
                                         HorizontalOptions="Center" Spacing="4">
                        <Label Text="🥈" FontSize="32" HorizontalOptions="Center"/>
                        <Label Text="{Binding Second.DisplayName}"
                               FontAttributes="Bold"
                               FontSize="13"
                               HorizontalOptions="Center"
                               MaxLines="1"
                               LineBreakMode="TailTruncation"/>
                        <Label Text="{Binding Second.TotalXp, StringFormat='{0} XP'}"
                               Style="{StaticResource Caption}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- 1st place -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                         HorizontalOptions="Center" Spacing="4">
                        <Label Text="👑" FontSize="24" HorizontalOptions="Center"/>
                        <Label Text="🥇" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="{Binding First.DisplayName}"
                               FontAttributes="Bold"
                               FontSize="15"
                               HorizontalOptions="Center"
                               MaxLines="1"
                               LineBreakMode="TailTruncation"/>
                        <Label Text="{Binding First.TotalXp, StringFormat='{0} XP'}"
                               Style="{StaticResource Caption}"
                               TextColor="{StaticResource Warning}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- 3rd place -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="2"
                                         HorizontalOptions="Center" Spacing="4">
                        <Label Text="🥉" FontSize="32" HorizontalOptions="Center"/>
                        <Label Text="{Binding Third.DisplayName}"
                               FontAttributes="Bold"
                               FontSize="13"
                               HorizontalOptions="Center"
                               MaxLines="1"
                               LineBreakMode="TailTruncation"/>
                        <Label Text="{Binding Third.TotalXp, StringFormat='{0} XP'}"
                               Style="{StaticResource Caption}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Podium bar -->
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                          ColumnDefinitions="*,*,*" ColumnSpacing="4" HeightRequest="60">
                        <BoxView Grid.Column="0" HeightRequest="40" VerticalOptions="End"
                                 Color="{StaticResource Gray200}" CornerRadius="4,4,0,0"/>
                        <BoxView Grid.Column="1" HeightRequest="60" VerticalOptions="End"
                                 Color="{StaticResource Warning}" CornerRadius="4,4,0,0"/>
                        <BoxView Grid.Column="2" HeightRequest="30" VerticalOptions="End"
                                 Color="{StaticResource Gray300}" CornerRadius="4,4,0,0"/>
                    </Grid>
                </Grid>

                <!-- Divider -->
                <BoxView HeightRequest="1" Color="{StaticResource Gray200}"/>

                <!-- Rest of the list -->
                <CollectionView ItemsSource="{Binding Rest}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:LeaderboardEntry">
                            <Border Margin="0,4"
                                    Padding="12,10"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCurrentUser}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Primary}"/>
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCurrentUser}" Value="False">
                                        <Setter Property="Stroke" Value="{StaticResource Gray200}"/>
                                        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="{Binding Rank}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="{StaticResource Gray500}"
                                           VerticalOptions="Center"
                                           WidthRequest="30"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="15"/>
                                        <Label Text="{Binding Department}" Style="{StaticResource Caption}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{Binding TotalXp, StringFormat='{0} XP'}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
    </Grid>

</ContentPage>
