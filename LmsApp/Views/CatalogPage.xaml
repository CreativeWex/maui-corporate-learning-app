<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LmsApp.ViewModels"
             xmlns:m="clr-namespace:LmsApp.Models.Domain"
             x:Class="LmsApp.Views.CatalogPage"
             x:DataType="vm:CatalogViewModel"
             Title="Каталог">

    <VerticalStackLayout Spacing="0">

        <!-- Search bar -->
        <SearchBar Placeholder="Поиск курсов..."
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding SearchCommand}"
                   Margin="16,8,16,0"/>

        <!-- View toggle -->
        <Grid ColumnDefinitions="*,Auto" Padding="16,4,16,4">
            <Label Grid.Column="0"
                   Text="{Binding Courses2.Count, StringFormat='{0} курсов'}"
                   Style="{StaticResource Caption}"
                   VerticalOptions="Center"/>
            <Button Grid.Column="1"
                    Text="{Binding ToggleLabel}"
                    Command="{Binding ToggleViewCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Padding="8,4"
                    FontSize="12"/>
        </Grid>

        <!-- Empty state -->
        <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                             HorizontalOptions="Center"
                             Spacing="8"
                             Margin="0,40,0,0">
            <Label Text="📚" FontSize="48" HorizontalOptions="Center"/>
            <Label Text="Курсы не найдены" Style="{StaticResource H3}" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Loading -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           Margin="0,20,0,0"/>

        <!-- Grid view -->
        <CollectionView ItemsSource="{Binding Courses2}"
                        IsVisible="{Binding IsGridView}"
                        Margin="16,0,16,0">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:Course">
                    <Border Style="{StaticResource CardBorder}" Margin="0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, Path=OpenCourseCommand}"
                                CommandParameter="{Binding Id}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   MaxLines="2"
                                   LineBreakMode="WordWrap"/>
                            <Label Text="{Binding Category}" Style="{StaticResource Caption}"/>
                            <ProgressBar Progress="{Binding ProgressPercent, Converter={StaticResource PercentToProgress}}"
                                         ProgressColor="{StaticResource Primary}"
                                         HeightRequest="4"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- List view -->
        <CollectionView ItemsSource="{Binding Courses2}"
                        IsVisible="{Binding IsGridView, Converter={StaticResource InvertBool}}"
                        Margin="16,0,16,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:Course">
                    <Border Style="{StaticResource CardBorder}" Margin="0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, Path=OpenCourseCommand}"
                                CommandParameter="{Binding Id}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15"/>
                                <Label Text="{Binding Category}" Style="{StaticResource Caption}"/>
                                <ProgressBar Progress="{Binding ProgressPercent, Converter={StaticResource PercentToProgress}}"
                                             ProgressColor="{StaticResource Primary}"
                                             HeightRequest="4"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="→"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>
